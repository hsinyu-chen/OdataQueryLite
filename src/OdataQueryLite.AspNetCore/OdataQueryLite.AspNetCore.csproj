<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>OdataQueryLite.AspNetCore</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>HsinYu Chen</Authors>
    <Description>ASP.NET Core MVC model binder + middleware glue for OdataQueryLite. One-line setup via services.AddOdataQueryLite() / app.UseOdataQueryLite().</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hsinyu-chen/OdataQueryLite</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hsinyu-chen/OdataQueryLite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>odata;aspnetcore;mvc;modelbinder;middleware</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OdataQueryLite\OdataQueryLite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OdataQueryLite.AspNetCore.Tests" />
  </ItemGroup>

</Project>
